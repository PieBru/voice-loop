models:
  gemma-4-e4b:
    darwin:
      repo: mlx-community/gemma-4-E4B-it-4bit
    linux:
      api_base: http://localhost:8088/v1
      model: Gemma4-E4B
  gemma-4-26b:
    darwin:
      repo: mlx-community/gemma-4-E4B-it-4bit
    linux:
      api_base: http://localhost:8088/v1
      model: Gemma4-26B
  gemma-4-e2b:
    darwin:
      repo: mlx-community/gemma-4-E2B-it-4bit
    linux:
      api_base: http://localhost:8088/v1
      model: Gemma4-E4B

languages:
  it:
    tts_voice: if_sara
    tts_lang: it
    llm_language: Italian
  de:
    tts_voice: af_heart
    tts_lang: de
    llm_language: German

tts:
  qwen_model: Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
  qwen_device: cuda:0
  qwen_cpp_bin: qwen3-tts-cli  # or absolute path
  qwen_cpp_model_dir: /path/to/qwen3-tts.cpp/models
  qwen_cpp_ref_audio: ""  # optional: WAV file for voice cloning
  voxcpm_ref_audio: ""    # optional: WAV file (5-30s) for voice cloning
  voxcpm_voice_desc: ""   # optional: text description for voice design (e.g. "warm female voice")
  voxcpm_device: auto     # cuda, cpu, mps, or auto

handlers:
  agentic:
    api_base: http://localhost:8089/v1
    model: agent-model-name
    timeout: 60
  zeroclaw:
    api_base: http://127.0.0.1:42617
    token: ""  # Bearer token from `zeroclaw gateway` pairing
    timeout: 120
